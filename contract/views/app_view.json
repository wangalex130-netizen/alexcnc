  "move_to": {
    "owner": "App 任务（alexcnc）—— 2026-09-18 昊总裁定，App 侧已实现并下发",
    "status": "App 已实现；固件待交付（工单 F3，与 F1 setWcsOffset / F2 framing 同期口径）",
    "purpose": "「拖动十字 → 移动到此」：把取点从按 ~15 次 jog 变成 拖一次 + 点一次",
    "frame": {"cmd": "move_to", "x": "number(mm, 绝对)", "y": "number(mm, 绝对)",
