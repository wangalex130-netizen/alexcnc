    "firmware_must": [
      "safe_z=true 时先抬 Z 至最高安全位，再动 XY（客户拖的是激光点、机器动的是刀）",
      "以 feed 走 XY 直线到绝对坐标（G0/G1 X.. Y.. F..）",
      "到位后回 cmd_ack（reqId 关联）；中断时回明确错误码，不静默",
      "Z 位置由固件决策，App 不下发任何 Z 值"
    ],
    "app_side": {
      "speed": "常速 + 距离分档（<5mm F200 / 5~50mm F1000 / >50mm F3000）",
      "no_s_curve": "App 不做 S 曲线、不逐帧改 F；加减速交给固件 planner（避免与其打架产生震荡）",
      "confirm_required": "拖动只改目标，松手后必须再点【移动到此】才下发（防手滑猛跑）",
      "gate": "同网限定 + state=idle + homed=true（绝对定位须已知机械坐标）",
      "fallback": "固件未响应时降级为分轴 jog（先 X 后 Y，串行等到位，L 形路径）"
    },
    "qos": 1,
    "note": "同目标重发幂等（走到同一坐标）；ts/seq 仅诊断，不参与跨端比较"
  },
